{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "plugins": ["typescript"],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "Record<string, unknown>": {
            "message": "Define the actual object shape, accept unknown at an unvalidated boundary, or use a specific key/value domain."
          },
          "Record<string, any>": {
            "message": "Same ban as Record<string, unknown>, and `any` also disables checking at every use site."
          },
          "Record<PropertyKey, unknown>": {
            "message": "Same ban as Record<string, unknown> under a wider key domain."
          }
        }
      }
    ],
    "anti-slop/no-chained-type-assertions": "warn",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-object-parameters": "warn",
    "anti-slop/no-runtime-typeof": "warn",
    "anti-slop/no-shape-in-symbol-names": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unknown-type-aliases": "warn",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-widen-then-assert": "warn"
  }
}
