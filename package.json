{
  "name": "@rbox/core",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "^1.4.0"
  },
  "description": "rbox sync engine (Phase 1: locally-testable core)",
  "scripts": {
    "prepare": "if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi",
    "dev:install": "bun scripts/dev-install.ts",
    "lint": "oxlint --quiet .",
    "lint:fix": "oxlint --quiet --fix .",
    "lint:affected": "bun scripts/lint-affected.ts",
    "test": "bun test ./src/ ./scripts/gc-drain.test.ts ./scripts/mutation-gate.test.ts",
    "test:api": "cd apps/api && vitest run",
    "test:affected": "bun scripts/test-affected.ts",
    "test:parallel": "bun scripts/test-parallel.ts",
    "test:storage-truth": "bun test ./scripts/storage-truth.test.ts ./scripts/storage-truth-live-unit.test.ts ./scripts/storage-truth-live.test.ts",
    "test:all": "bun test ./src/ ./scripts/gc-drain.test.ts && bun run test:storage-truth && cd apps/api && vitest run",
    "typecheck": "mkdir -p .cache/tsbuildinfo && tsc --noEmit --incremental --tsBuildInfoFile .cache/tsbuildinfo/root.tsbuildinfo && tsc -p apps/api --noEmit --incremental --tsBuildInfoFile .cache/tsbuildinfo/apps-api.tsbuildinfo && bun run typecheck:scripts",
    "guards": "bun scripts/guards.ts",
    "gate:mutation": "bun scripts/mutation-gate.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "gate:dl-integrity": "bun scripts/dl-integrity-gate.ts",
    "rig": "bun scripts/rig/rig.ts",
    "tui-smoke": "bun scripts/tui-compiled-smoke.ts",
    "tui-budget": "bun scripts/tui-performance-budget.ts",
    "test:rig": "bun test ./scripts/rig/",
    "e2e:dev": "bun scripts/e2e/dev-backed-scenario.ts",
    "demo": "bun scripts/dev-demo.ts"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.6",
    "chokidar": "^5.0.0",
    "ignore": "^5.3.2",
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "^4.20260626.1",
    "@oxlint/plugins": "1.77.0",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.17",
    "oxlint": "1.77.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.107.0"
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-arm64": "^2.5.6",
    "@parcel/watcher-linux-arm64-glibc": "^2.5.6",
    "@parcel/watcher-linux-x64-glibc": "^2.5.6"
  },
  "patchedDependencies": {
    "ink@7.1.1": "patches/ink@7.1.1.patch"
  }
}
