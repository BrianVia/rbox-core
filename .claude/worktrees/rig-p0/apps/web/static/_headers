# Cloudflare Pages headers (SF5). CSP scopes the origins the dashboard may talk to
# (Clerk FAPI, Stripe, Turnstile, the rbox API); script/style keep unsafe-inline +
# unsafe-eval because Clerk's bundle needs them in a static SPA (no nonce/SSR) —
# origin-scoping is the real exfiltration defense here. Cache: hashed assets are
# immutable, the HTML shell always revalidates so deploys land instantly.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://clerk.rbox.to https://*.clerk.accounts.dev https://js.stripe.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.rbox.to https://rbox-dev-api.brian-via.workers.dev https://clerk.rbox.to https://*.clerk.accounts.dev; frame-src https://challenges.cloudflare.com https://js.stripe.com https://checkout.stripe.com https://clerk.rbox.to https://*.clerk.accounts.dev; img-src 'self' data: https://img.clerk.com https://*.clerk.accounts.dev; worker-src 'self' blob:; base-uri 'self'; form-action 'self' https://checkout.stripe.com

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/200.html
  Cache-Control: no-cache
