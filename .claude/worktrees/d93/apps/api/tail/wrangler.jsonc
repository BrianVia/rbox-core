{
  // §32 Tier 2 — rbox Tail Worker (separate from the api Worker). Attached to the api
  // Worker via its `tail_consumers` block. Stateless; its only binding is the
  // #rbox-alerts Slackpipes webhook (a `wrangler secret`, never in repo).
  "name": "rbox-dev-tail",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-23",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "production": {
      "name": "rbox-prod-tail"
    }
  }
}
