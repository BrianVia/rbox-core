#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

bun_bin="$(command -v bun || true)"
if [ -z "$bun_bin" ] && [ -x "$HOME/.bun/bin/bun" ]; then
  bun_bin="$HOME/.bun/bin/bun"
fi

if [ -z "$bun_bin" ]; then
  echo "pre-commit: Bun is required to run the repository lint gate." >&2
  exit 1
fi

"$bun_bin" run lint

# Non-blocking: surfaces anti-slop's "warn"-level findings on just the files
# you're committing, without --quiet, so they stay visible for incremental
# cleanup instead of drowning in the ~3,900 pre-existing repo-wide hits (see
# .oxlintrc.json). Warnings never fail this hook; only oxlint's "error" rules
# (still gated above) do.
exec "$bun_bin" run lint:affected
